# ReactiveBase Environment Variables
# Copy this file to .env and update the values

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@localhost:5432/reactivebase

# Optional: Server port (default: 4000)
# PORT=4000

# Optional: Node environment
# NODE_ENV=development

# Optional: Redis URL for multi-server pub/sub
# REDIS_URL=redis://localhost:6379

# Optional: JWT secret for HS256 token signing
# JWT_SECRET=your-secret-key

# Optional: JWT issuer and audience
# JWT_ISSUER=https://your-issuer.example.com
# JWT_AUDIENCE=your-audience

# Optional: Logging level (debug, info, warn, error)
# LOG_LEVEL=info

# Optional: ReactiveBase Cloud API key
# REACTIVEBASE_API_KEY=

# Optional: Neon database branching API key
# NEON_API_KEY=

# Optional: Fly.io deployment token
# FLY_API_TOKEN=
