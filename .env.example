# ReactiveBase Environment Variables
# Copy this file to .env and update the values

# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:pass@localhost:5432/reactivebase

# ─── Server Configuration ─────────────────────────────────────────────────────

# HTTP/WebSocket server port (default: 4000)
# PORT=4000

# Node environment: development | production | test
# NODE_ENV=development

# Logging level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Allowed CORS origins (default: * in dev, must be set in production)
# CORS_ORIGIN=https://your-app.com

# ─── Authentication ───────────────────────────────────────────────────────────

# JWT secret for HS256 token signing (required in production)
# JWT_SECRET=your-secret-key-at-least-32-chars

# JWT issuer URL (for RS256/JWKS verification)
# JWT_ISSUER=https://your-auth-provider.example.com

# JWT audience claim
# JWT_AUDIENCE=your-audience

# ─── Infrastructure ───────────────────────────────────────────────────────────

# Redis URL for multi-instance pub/sub and rate limiting
# REDIS_URL=redis://localhost:6379

# Dashboard and metrics endpoint authentication token
# DASHBOARD_TOKEN=your-dashboard-token

# ─── Cloud & Deployment ───────────────────────────────────────────────────────

# Fly.io API token (for fly deploy command)
# FLY_API_TOKEN=

# Railway API token (for railway deploy command)
# RAILWAY_TOKEN=

# ─── Optional Integrations ────────────────────────────────────────────────────

# AWS S3 storage (for file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# AI/LLM provider (for AI assistant features)
# OPENAI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Stripe billing (for SaaS multi-tenancy)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
