{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "ReactiveBase server observability — queries, mutations, subscriptions, and infrastructure metrics",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        { "expr": "rate(reactivebase_queries_total[5m])", "legendFormat": "Queries/s" },
        { "expr": "rate(reactivebase_mutations_total[5m])", "legendFormat": "Mutations/s" },
        { "expr": "rate(reactivebase_actions_total[5m])", "legendFormat": "Actions/s" }
      ]
    },
    {
      "id": 2,
      "title": "Query Latency",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(reactivebase_query_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(reactivebase_query_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(reactivebase_query_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "color": { "fixedColor": "red", "mode": "fixed" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }
      },
      "targets": [
        { "expr": "rate(reactivebase_errors_total[5m]) / (rate(reactivebase_queries_total[5m]) + rate(reactivebase_mutations_total[5m]) + 0.001)", "legendFormat": "Error Rate" }
      ]
    },
    {
      "id": 4,
      "title": "Active Subscriptions",
      "type": "stat",
      "gridPos": { "x": 0, "y": 9, "w": 4, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 50000 }] } }
      },
      "targets": [
        { "expr": "reactivebase_subscriptions_active", "legendFormat": "Subscriptions" }
      ]
    },
    {
      "id": 5,
      "title": "WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 4, "y": 9, "w": 4, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "reactivebase_connections_active", "legendFormat": "Connections" }
      ]
    },
    {
      "id": 6,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "x": 8, "y": 9, "w": 4, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "reactivebase_uptime_seconds", "legendFormat": "Uptime" }
      ]
    },
    {
      "id": 7,
      "title": "Pending Jobs",
      "type": "stat",
      "gridPos": { "x": 12, "y": 9, "w": 4, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "reactivebase_scheduler_pending_jobs", "legendFormat": "Pending" }
      ]
    },
    {
      "id": 8,
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 9, "w": 4, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "bytes", "max": 1073741824 } },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"reactivebase\"}", "legendFormat": "RSS" }
      ]
    },
    {
      "id": 9,
      "title": "CPU Usage",
      "type": "gauge",
      "gridPos": { "x": 20, "y": 9, "w": 4, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"reactivebase\"}[5m])", "legendFormat": "CPU" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Reactivity Engine",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Subscription Invalidation Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "rate(reactivebase_invalidations_total[5m])", "legendFormat": "Invalidations/s" },
        { "expr": "rate(reactivebase_invalidations_skipped_total[5m])", "legendFormat": "Skipped/s" }
      ]
    },
    {
      "id": 11,
      "title": "Subscription Fanout",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "reactivebase_invalidation_subscriptions_affected", "legendFormat": "Affected Subscriptions" },
        { "expr": "histogram_quantile(0.99, rate(reactivebase_invalidation_duration_seconds_bucket[5m]))", "legendFormat": "Re-execution Time (p99)" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Database",
      "type": "row"
    },
    {
      "id": 12,
      "title": "Database Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "reactivebase_pg_pool_total", "legendFormat": "Total" },
        { "expr": "reactivebase_pg_pool_active", "legendFormat": "Active" },
        { "expr": "reactivebase_pg_pool_idle", "legendFormat": "Idle" },
        { "expr": "reactivebase_pg_pool_waiting", "legendFormat": "Waiting" }
      ]
    },
    {
      "id": 13,
      "title": "Transaction Performance",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "rate(reactivebase_tx_commits_total[5m])", "legendFormat": "Commits/s" },
        { "expr": "rate(reactivebase_tx_rollbacks_total[5m])", "legendFormat": "Rollbacks/s" },
        { "expr": "rate(reactivebase_tx_retries_total[5m])", "legendFormat": "Serialization Retries/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "Scheduler",
      "type": "row"
    },
    {
      "id": 14,
      "title": "Job Queue",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "reactivebase_scheduler_pending_jobs", "legendFormat": "Pending" },
        { "expr": "rate(reactivebase_scheduler_completed_total[5m])", "legendFormat": "Completed/s" },
        { "expr": "rate(reactivebase_scheduler_failed_total[5m])", "legendFormat": "Failed/s" }
      ]
    },
    {
      "id": 15,
      "title": "Job Duration",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(reactivebase_job_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, rate(reactivebase_job_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 104,
      "title": "Slow Queries",
      "type": "row"
    },
    {
      "id": 16,
      "title": "Top 10 Slowest Queries (avg)",
      "type": "table",
      "gridPos": { "x": 0, "y": 41, "w": 24, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "topk(10, reactivebase_query_duration_seconds_sum / reactivebase_query_duration_seconds_count)", "legendFormat": "{{query_name}}", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "Avg Duration (s)", "__name__": "Metric", "query_name": "Query" } } }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["reactivebase", "observability"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(reactivebase_queries_total, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "query": "label_values(reactivebase_queries_total, instance)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ReactiveBase — Server Observability",
  "uid": "reactivebase-server",
  "version": 1
}
