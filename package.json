{
  "name": "reactivebase-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:server": "turbo run test --filter=@reactivebase/server",
    "test:client": "turbo run test --filter=@reactivebase/client",
    "test:react": "turbo run test --filter=@reactivebase/react",
    "test:vue": "turbo run test --filter=@reactivebase/vue",
    "test:svelte": "turbo run test --filter=@reactivebase/svelte",
    "test:nextjs": "turbo run test --filter=@reactivebase/nextjs",
    "test:edge": "turbo run test --filter=@reactivebase/edge",
    "test:cli": "turbo run test --filter=@reactivebase/cli",
    "test:coverage": "turbo run test:coverage",
    "test:file": "vitest run",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "fix": "npm run format && turbo run lint -- --fix",
    "benchmark": "turbo run benchmark",
    "version:bump": "node scripts/version-bump.js",
    "check": "turbo run build typecheck test lint && npm run format:check",
    "check:quick": "turbo run typecheck lint && npm run format:check",
    "docs:api": "typedoc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.4.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
