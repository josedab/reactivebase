{
  "name": "@reactivebase/cli",
  "version": "0.1.0",
  "description": "ReactiveBase CLI - dev server, generate, migrate",
  "type": "module",
  "bin": {
    "reactivebase": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@reactivebase/server": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "reactivebase",
    "cli",
    "dev-server",
    "migrations",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
