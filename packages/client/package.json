{
  "name": "@reactivebase/client",
  "version": "0.1.0",
  "description": "ReactiveBase client SDK - subscriptions, cache, transport",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "reactivebase",
    "reactive",
    "client",
    "realtime",
    "typescript",
    "websocket",
    "subscriptions"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
