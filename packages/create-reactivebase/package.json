{
  "name": "create-reactivebase",
  "version": "0.1.0",
  "description": "Create a new ReactiveBase project",
  "type": "module",
  "bin": {
    "create-reactivebase": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/create-reactivebase"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "reactivebase",
    "create",
    "scaffolding",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
