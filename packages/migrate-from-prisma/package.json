{
  "name": "@reactivebase/migrate-from-prisma",
  "version": "0.1.0",
  "description": "Migrate your Prisma schema to ReactiveBase with one command",
  "type": "module",
  "bin": {
    "migrate-from-prisma": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@reactivebase/server": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/migrate-from-prisma"
  },
  "license": "MIT",
  "keywords": [
    "reactivebase",
    "prisma",
    "migration",
    "orm",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
