{
  "name": "@reactivebase/nextjs",
  "version": "0.1.0",
  "description": "ReactiveBase Next.js integration - SSR preloading and App Router support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@reactivebase/client": "workspace:*",
    "@reactivebase/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "next": "^16.1.6",
    "react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/nextjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "reactivebase",
    "reactive",
    "nextjs",
    "ssr",
    "realtime",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
