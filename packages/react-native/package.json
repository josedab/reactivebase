{
  "name": "@reactivebase/react-native",
  "version": "0.1.0",
  "description": "ReactiveBase React Native SDK - offline-first reactive queries for mobile",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./sqlite-storage": {
      "import": "./dist/sqlite-storage.js",
      "require": "./dist/sqlite-storage.cjs",
      "types": "./dist/sqlite-storage.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@reactivebase/client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/react-native"
  },
  "license": "MIT",
  "keywords": [
    "reactivebase",
    "react-native",
    "mobile",
    "offline-first",
    "realtime",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
