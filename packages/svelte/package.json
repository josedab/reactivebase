{
  "name": "@reactivebase/svelte",
  "version": "0.1.0",
  "description": "ReactiveBase Svelte stores - reactive query subscriptions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@reactivebase/client": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "reactivebase",
    "reactive",
    "svelte",
    "stores",
    "realtime",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
