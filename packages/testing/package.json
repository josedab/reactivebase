{
  "name": "@reactivebase/testing",
  "version": "0.1.0",
  "description": "ReactiveBase testing utilities - in-memory server, mock database, test helpers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@reactivebase/server": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivebase/reactivebase.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "reactivebase",
    "testing",
    "mock",
    "test-helpers",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
